<Window x:Class="HDRPilot.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="HDR Pilot" Width="1220" Height="840" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,16"><DockPanel><Border Width="42" Height="42" CornerRadius="12" Background="#18392F" Margin="0,0,14,0" DockPanel.Dock="Left"><TextBlock Text="P" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel DockPanel.Dock="Left"><TextBlock Text="HDR PILOT" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Your display, in the right light." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel><TextBlock Text="●  LOCAL BY DESIGN" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}" FontSize="11"/></DockPanel></Border>
 <TabControl x:Name="Navigation" Grid.Row="1" TabStripPlacement="Left" Background="{StaticResource Bg}" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ItemContainerStyle="{StaticResource NavItem}">
 <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,22"><StackPanel><TabPanel IsItemsHost="True"/><TextBlock Text="WINDOWS 11 · v0.1.0" Foreground="#727E94" FontSize="10" Margin="18,32,0,0"/></StackPanel></Border><ContentPresenter x:Name="PART_SelectedContentHost" TextElement.Foreground="{StaticResource Ink}" Grid.Column="1" ContentSource="SelectedContent" Margin="32,26,32,12"/></Grid></ControlTemplate></TabControl.Template>
 <TabItem Header="◈   Dashboard"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="A clearer everyday." Style="{StaticResource PageTitle}"/><TextBlock Text="Intelligent HDR control that respects your choices." Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
 <Border CornerRadius="16" Padding="28" BorderBrush="#3A5E56" BorderThickness="1" Margin="0,0,0,22"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1E3935"/><GradientStop Color="#172130" Offset="0.65"/><GradientStop Color="#171D29" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><DockPanel><Border DockPanel.Dock="Right" CornerRadius="6" Background="#183C31" Padding="12,6"><TextBlock Text="{Binding HdrStatus}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border><TextBlock Text="YOUR DISPLAY" Foreground="#9CC5B9" FontSize="11" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding DisplayTitle}" FontSize="32" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock Text="{Binding DisplaySummary}" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Label" MaxWidth="420" HorizontalAlignment="Left" MinWidth="250" Margin="0,18,0,20" AutomationProperties.Name="Target display"/><WrapPanel><Button Content="Toggle HDR" Command="{Binding ToggleCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Resume automatic" Command="{Binding AutomaticCommand}"/><Button Content="Pause automation" Command="{Binding PauseCommand}"/></WrapPanel></StackPanel></Border>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="AUTOMATION" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Automation}" FontSize="22" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="FOREGROUND APPLICATION" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding ActiveApplication}" FontSize="22" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel></Border></Grid>
 <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Why this state?" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ActiveRule}" Style="{StaticResource MutedText}"/></StackPanel></Border><TextBlock Text="{Binding Metrics}" Style="{StaticResource MutedText}" FontSize="12"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="▣   Displays"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Every display, independently." Style="{StaticResource PageTitle}"/><TextBlock Text="HDR state is verified with Windows after each change." Style="{StaticResource MutedText}" Margin="0,0,0,24"/><ItemsControl ItemsSource="{Binding Displays}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardBorder}"><StackPanel><DockPanel><TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Name}" FontSize="24"/></DockPanel><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,10"/><TextBlock Text="{Binding Limitation}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/><Button Content="Toggle this display" HorizontalAlignment="Left" IsEnabled="{Binding CanSetHdr}" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Open Windows display settings" HorizontalAlignment="Left" Command="{Binding WindowsSettingsCommand}"/></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="◇   Games · الألعاب">
  <Grid FlowDirection="RightToLeft" Loaded="GamesLoaded">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="أضف لعبتك بخطوتين." Style="{StaticResource PageTitle}"/><TextBlock Text="اختَر اللعبة واضغط إعداد HDR، ثم احفظ. الإعدادات الأساسية جاهزة." Style="{StaticResource MutedText}" Margin="0,0,0,18"/></StackPanel>
   <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ابحث باسم اللعبة أو المتجر" FontSize="12" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding GameSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="البحث عن لعبة"/></StackPanel><Button Grid.Column="1" Content="تحديث الألعاب" Command="{Binding ScanCommand}" Margin="12,22,0,16" VerticalAlignment="Bottom"/></Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="الألعاب المثبتة" Style="{StaticResource SectionTitle}"/>
     <ListBox Grid.Row="1" ItemsSource="{Binding GameView}" AutomationProperties.Name="الألعاب المثبتة" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" FlowDirection="LeftToRight" TextAlignment="Right"/><TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="{Binding ProfileStatus}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding DataContext.AddGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Padding="12,9" Margin="0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource CardBorder}" Padding="20"><StackPanel>
      <TextBlock Text="اللعبة مفتوحة الآن؟" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="هذه أسهل طريقة إذا لم تظهر لعبتك في القائمة." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
      <TextBlock Text="التطبيقات المفتوحة" FontSize="12"/>
      <ComboBox ItemsSource="{Binding RunningGames}" SelectedItem="{Binding SelectedRunningGame}" DisplayMemberPath="Name" FlowDirection="LeftToRight" AutomationProperties.Name="اختيار اللعبة المفتوحة" MaxDropDownHeight="250"/>
      <Button Content="إضافة اللعبة المختارة" Command="{Binding AddRunningGameCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"/>
      <TextBlock Text="{Binding RunningGameHint}" Style="{StaticResource MutedText}" FontSize="12"/>
     </StackPanel></Border>
     <Border Style="{StaticResource CardBorder}" Padding="20"><StackPanel><TextBlock Text="لعبة غير موجودة بالقائمة؟" FontWeight="SemiBold" Margin="0,0,0,12"/><Button Content="اختيار ملف اللعبة…" Command="{Binding BrowseGameCommand}" Margin="0,0,0,10"/><TextBlock Text="بعد الإضافة تظهر علامة ✓ بجانب اللعبة. تقدر تعدّل البروفايلات أيضًا من Applications." Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
   <TextBlock Grid.Row="3" Text="{Binding GamePageStatus}" Foreground="{StaticResource Accent}" Margin="0,14,0,0"/>
  </Grid>
 </TabItem>
 <TabItem Header="▤   Applications"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Make it personal." Style="{StaticResource PageTitle}"/><TextBlock Text="Profiles match the full executable path. Higher priorities win." Style="{StaticResource MutedText}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search profiles" ToolTip="Search profiles"/></StackPanel><WrapPanel Grid.Row="1"><Button Content="Add application" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="Edit selected" Command="{Binding EditCommand}"/><Button Content="Remove selected" Command="{Binding DeleteCommand}"/></WrapPanel><DataGrid Grid.Row="2" ItemsSource="{Binding ProfileView}" SelectedItem="{Binding SelectedProfile}" Margin="0,8,0,18"><DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Policy" Binding="{Binding Mode}" Width="150"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/><DataGridTextColumn Header="Last played" Binding="{Binding LastPlayed, StringFormat={}{0:g}}" Width="150"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="3" Text="Add a currently running application" Style="{StaticResource SectionTitle}"/><DockPanel Grid.Row="4"><Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshRunningCommand}" Margin="10,6,0,16"/><Button DockPanel.Dock="Right" Content="Add selected" Command="{Binding AddRunningCommand}" Margin="10,6,0,16"/><ComboBox ItemsSource="{Binding Running}" SelectedItem="{Binding SelectedProcess}" DisplayMemberPath="Name" AutomationProperties.Name="Running application"/></DockPanel></Grid></TabItem>
 <TabItem Header="▷   Video &amp; Browsers"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="A better picture, on your terms." Style="{StaticResource PageTitle}"/><TextBlock Text="Windows HDR and NVIDIA RTX Video HDR are separate controls." Style="{StaticResource MutedText}" Margin="0,0,0,22"/><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="YouTube companion" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding BrowserStatus}" Foreground="{StaticResource Accent}"/><CheckBox Content="Enable the local browser bridge" IsChecked="{Binding Draft.BrowserEnabled}"/><CheckBox Content="Only request HDR for fullscreen video" IsChecked="{Binding Draft.BrowserFullscreenOnly}"/><CheckBox Content="Request Windows HDR for video classified as SDR (RTX Video)" IsChecked="{Binding Draft.RequestHdrForSdrVideo}"/><TextBlock Text="Load the included browser folder as an unpacked extension in Chrome or Edge. Register its ID with scripts/Register-BrowserBridge.ps1. Classify the YouTube video in the extension popup. Playback is detected automatically; unknown content never requests HDR." Style="{StaticResource MutedText}"/><Button Content="Save video preferences" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="NVIDIA RTX Video HDR" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding GpuStatus}" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/><TextBlock Text="Configure RTX Video HDR in NVIDIA App → System → Video, or supported NVIDIA Control Panel options. HDR Pilot only requests Windows HDR; it does not change driver settings or confirm RTX Video processing is active." Style="{StaticResource MutedText}"/><Button Content="NVIDIA setup guide ↗" Command="{Binding NvidiaHelpCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Desktop video players" Style="{StaticResource SectionTitle}"/><TextBlock Text="Add VLC, MPC-HC, MPC-BE, mpv, PotPlayer, or Windows Media Player under Applications. Choose fullscreen, foreground, or running behavior. Basic profiles cannot identify content HDR. Advanced player metadata integrations are not included in this release." Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="⇄   Automation Rules"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Predictable by design." Style="{StaticResource PageTitle}"/><TextBlock Text="Every change has a reason." Style="{StaticResource MutedText}" Margin="0,0,0,24"/><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Current decision" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ActiveRule}" Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Rule order" Style="{StaticResource SectionTitle}"/><TextBlock Text="1. Detected manual changes suspend control of that display.&#10;2. Pause releases only changes HDR Pilot still owns.&#10;3. Always HDR / SDR overrides application rules.&#10;4. Profiles use highest priority, then stable profile ID.&#10;5. Eligible YouTube video can request HDR in Automatic mode.&#10;6. When rules end, only owned changes are restored." Style="{StaticResource MutedText}"/><TextBlock Text="Force SDR releases HDR Pilot's HDR. It preserves HDR that was already on. Use the manual HDR button for an explicit user-directed change." Style="{StaticResource MutedText}" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Ownership has limits" Style="{StaticResource SectionTitle}"/><TextBlock Text="Windows does not identify who changed HDR. A detected external change yields control until Resume automatic. Same-state writes and changes entirely between observations cannot be attributed. Reconnection, wake, or uncertain display queries discard old ownership and preserve the current state." Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="≡   Activity Log"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="A little transparency." Style="{StaticResource PageTitle}"/><TextBlock Text="Local activity only. No window titles or browsing URLs." Style="{StaticResource MutedText}"/></StackPanel><TextBox Grid.Row="1" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter activity log"/><ListBox Grid.Row="2" ItemsSource="{Binding ActivityView}" Margin="0,0,0,18"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="3" Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" HorizontalAlignment="Left"/></Grid></TabItem>
 <TabItem Header="⚙   Settings"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Quietly in the background." Style="{StaticResource PageTitle}"/><TextBlock Text="Closing the window keeps HDR Pilot running in the tray." Style="{StaticResource MutedText}" Margin="0,0,0,22"/><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Automation &amp; startup" Style="{StaticResource SectionTitle}"/><TextBlock Text="Automation mode"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Draft.Mode}"/><TextBlock Text="Minimum time between switches (ms, 1,000–120,000)"/><TextBox Text="{Binding Draft.CooldownMs}"/><CheckBox Content="Start with Windows (current user only)" IsChecked="{Binding StartWithWindows}"/><CheckBox Content="Start minimized to the tray" IsChecked="{Binding Draft.StartMinimized}"/><CheckBox Content="Notify when a display HDR state or automation mode changes" IsChecked="{Binding Draft.Notifications}"/><Button Content="Enable &amp; test notifications" Command="{Binding TestNotificationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="Shows each display name and its observed HDR state. Windows Do not disturb may hide banners." Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Global shortcuts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Defaults below. Key codes and modifier masks can be customized in exported JSON. Conflicts appear in the activity log." Style="{StaticResource MutedText}"/><CheckBox Content="Toggle HDR · Win + Alt + H" IsChecked="{Binding Draft.Hotkeys[Toggle].Enabled}"/><CheckBox Content="Automatic · Win + Alt + A" IsChecked="{Binding Draft.Hotkeys[Automatic].Enabled}"/><CheckBox Content="Pause · Win + Alt + P" IsChecked="{Binding Draft.Hotkeys[Pause].Enabled}"/><CheckBox Content="Cycle override · Win + Alt + O" IsChecked="{Binding Draft.Hotkeys[Cycle].Enabled}"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="OLED-friendly defaults" Style="{StaticResource SectionTitle}"/><TextBlock Text="Dark surfaces, no overlay, optional notifications, and a switching cooldown. HDR switching does not prevent burn-in; cumulative use and persistent bright static content remain the main considerations." Style="{StaticResource MutedText}"/></StackPanel></Border><WrapPanel><Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}"/><Button Content="Export" Command="{Binding ExportCommand}"/><Button Content="Import" Command="{Binding ImportCommand}"/><Button Content="Reset defaults" Command="{Binding ResetCommand}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
 <TabItem Header="ⓘ   About"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="HDR Pilot" Style="{StaticResource PageTitle}"/><TextBlock Text="Version 0.1.0 · Independent, open-source Windows HDR automation" Style="{StaticResource MutedText}" Margin="0,0,0,24"/><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Built for your PC." Style="{StaticResource SectionTitle}"/><TextBlock Text="C# · .NET 10 · WPF&#10;&#10;No accounts, telemetry, advertisements, or cloud dependency. Normal use needs no administrator rights. Settings and logs stay on your computer.&#10;&#10;Exit through the tray to restore owned changes safely. After a forced termination, the next launch preserves the current display state." Style="{StaticResource MutedText}"/></StackPanel></Border><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Updates &amp; release status" Style="{StaticResource SectionTitle}"/><TextBlock Text="Releases: github.com/hmh6a/hdr-pilot. Portable builds are unsigned and hardware coverage is limited. Network update checks and automatic installation are disabled; download updates from the official repository." Style="{StaticResource MutedText}"/></StackPanel></Border><TextBlock Text="MIT license. See README.md, SECURITY.md, and docs/HARDWARE-TESTING.md in the portable package." Style="{StaticResource MutedText}"/><Button Content="Exit HDR Pilot" Click="ExitClicked" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
 </TabControl><Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#10151E" Padding="24,11"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="12" MaxHeight="48"/></Border></Grid>
</Window>
