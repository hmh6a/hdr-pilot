<Window x:Class="HDRPilot.App.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Application profile · HDR Pilot" Width="620" Height="790" MinHeight="600" WindowStartupLocation="CenterOwner"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="Application profile" Style="{StaticResource PageTitle}"/><TextBlock Text="Name"/><TextBox x:Name="ProfileName"/><TextBlock Text="Executable path"/><TextBox x:Name="Executable"/><TextBlock Text="HDR policy"/><ComboBox x:Name="Policy"/><TextBlock Text="Target display"/><ComboBox x:Name="Target" DisplayMemberPath="Name"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Activation delay (ms)"/><TextBox x:Name="Activation"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Deactivation delay (ms)"/><TextBox x:Name="Deactivation"/></StackPanel></Grid><TextBlock Text="Priority (−1,000 to 1,000; higher wins)"/><TextBox x:Name="Priority"/><CheckBox x:Name="Enabled" Content="Enable this profile"/><CheckBox x:Name="Minimized" Content="Ignore when minimized"/><TextBlock Text="Automatic means foreground fullscreen. WhileRunning stays active while a qualifying window exists. NeverModify preserves the current state while this rule wins. ForceSdr only releases HDR owned by HDR Pilot." Style="{StaticResource MutedText}"/><TextBlock x:Name="ErrorText" Foreground="#FFB6AA" Margin="0,12"/><WrapPanel><Button Content="Save profile" Style="{StaticResource PrimaryButton}" Click="Save" IsDefault="True"/><Button Content="Cancel" IsCancel="True"/></WrapPanel></StackPanel></ScrollViewer></Window>
